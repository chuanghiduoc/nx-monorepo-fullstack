# Configuration for the production-shaped local run.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build
#
# `.env.prod` is not tracked. A real deployment reads these from its secret
# manager and never from a file on disk.

# The one origin everything is served from. It is inlined into the browser
# bundle at build time, so changing it means rebuilding the web image.
PUBLIC_ORIGIN=http://localhost:8080

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-production-shape-secret-at-least-32-chars

# The database superuser, for the container and for the migration job only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# The application role's password. The migration creates the role without one;
# granting it is an operator's job, and locally the database's init script does
# it with this value.
APP_USER_PASSWORD=app_user

# The worker's role, which has the same table rights and none of the session
# handling. A password of its own, because sharing one would make the two roles
# a formality.
WORKER_USER_PASSWORD=worker_user

# Which hops may report a client's address. The compose network, so only the
# edge is believed. Anything wider and a caller could name its own address.
TRUSTED_PROXIES=172.16.0.0/12

LOG_LEVEL=info

# Requests per window, per client address.
#
# A deployment leaves this at the schema's default: behind a real edge every
# person arrives from their own address, and 100 a minute is generous for one.
# On this rig every browser, every worker and every curl shares one address, so
# the default is reached by the test suite alone — which is a true report about
# the rate limit and a false one about the application.
THROTTLE_LIMIT=5000
THROTTLE_TTL_MS=60000

# Attempts on a credential route, per address, per minute. Ten is what a
# deployment wants. This rig signs up once per test from one address, so it
# raises the number deliberately rather than discovering the limit as a
# failure that looks like a broken form.
AUTH_CREDENTIAL_MAX_ATTEMPTS=1000
AUTH_RATE_LIMIT_MAX=20000

# The local storage driver signs its own URLs, and a driver with no key would
# hand out URLs anybody could forge — so it is refused at boot instead. Any
# 32-character secret will do; it never leaves this deployment.
STORAGE_SIGNING_SECRET=change-me-to-a-real-32-char-secret

# The assistant is off unless a provider is named. A stack that refused to
# start without an API key would be a stack nobody can bring up to look at.
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-...
