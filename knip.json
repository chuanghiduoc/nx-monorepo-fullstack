{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    ".agents/**",
    ".github/skills/**",
    ".opencode/**"
  ],
  "ignoreDependencies": [
    "tslib",
    "@babel/core",
    "@babel/preset-react",
    "@eslint/js",
    "@nestjs/schematics",
    "@nestjs/testing",
    "@nx/nest",
    "@nx/node",
    "@nx/web",
    "eslint-config-next",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "prettier",
    "typescript-eslint",
    "@nx/plugin",
    "@typescript/native"
  ],
  "webpack": false,
  "workspaces": {
    "apps/core/api": {
      "entry": [
        "src/main.ts",
        "webpack.config.js"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/workspace-plugin": {
      "entry": [
        "src/generators/*/*.ts"
      ],
      "ignoreExportsUsedInFile": true
    }
  }
}
