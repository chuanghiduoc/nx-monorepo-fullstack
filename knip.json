{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    ".agents/**",
    ".github/skills/**",
    ".opencode/**"
  ],
  "ignoreDependencies": [
    "tslib",
    "@eslint/js",
    "@nx/nest",
    "@nx/node",
    "@nx/web",
    "@nx/plugin",
    "eslint-config-next",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "typescript-eslint",
    "prettier",
    "@typescript/native",
    "@opentelemetry/api"
  ],
  "webpack": false,
  "workspaces": {
    "apps/core/api": {
      "entry": [
        "src/main.ts",
        "webpack.config.js"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/workspace-plugin": {
      "entry": [
        "src/generators/*/*.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "libs/shared/api-client-core": {
      "entry": [
        "src/generated/**/*.ts"
      ]
    },
    "libs/core/server/data-access-db": {
      "ignoreDependencies": [
        "@prisma/client",
        "pg"
      ],
      "entry": [
        "prisma7.config.ts"
      ]
    }
  },
  "ignoreUnresolved": [
    "^\\*$"
  ]
}
