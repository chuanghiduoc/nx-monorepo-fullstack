# Copy to .env and adjust. Values below match docker-compose.yml defaults.
#
# Every variable the environment schema accepts appears here, commented out
# where the default is the right answer: a setting nobody knows about is not
# configurable, whatever the schema says. A test compares the two lists.

# --- Process ---
# Chooses defaults elsewhere: which interface to bind, whether interactive docs
# are on, and how cookies are set. `test` is for the suites, which want
# production behaviour without production values.
#
# **Commented out on purpose, and it must stay that way.** Nx loads this file
# into every task it runs, so a value here is a value `next build` and
# `webpack` see too — and `NODE_ENV=development` makes a production build a
# development one. Measured: it turned `core-web:build` red with a prerender
# error in a page that is fine, hours after `pnpm dev` appended the line.
#
# Nothing needs it set. The schema defaults to `development`, every build tool
# sets its own, and a deployment sets it in the environment rather than here.
# NODE_ENV=development

# fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- Database ---
# The application connects as app_user, which is bound by row-level security.
# Connecting as the owner would make every RLS policy advisory: FORCE ROW LEVEL
# SECURITY binds table owners and never superusers.
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/app
# Migrations run as the owner — DDL is deliberately outside app_user's rights.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Throwaway database Prisma replays migrations into when checking for drift.
# Never point this at a database that holds anything: Prisma resets it.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_shadow
# The worker connects as its own role. A separate variable rather than a shared
# one because both processes read the environment of the same shell here: with
# one name, whichever role it held would be the role both connect as, and the
# one that is wrong is the one with more rights than it needs.
WORKER_DATABASE_URL=postgresql://worker_user:worker_user@localhost:5432/app

# --- Redis: two roles, never one instance ---
# Queue, quota, rate limit, locks — must never evict.
REDIS_CRITICAL_URL=redis://localhost:6379
# Disposable cache and transient realtime state.
REDIS_CACHE_URL=redis://localhost:6380

# --- Realtime ---
# Where SSE and Socket.IO fan out. Unset means the queue's instance, which
# every process already has — Pub/Sub stores nothing, so it does not violate
# that instance's noeviction. Point it elsewhere when realtime volume is real.
# REALTIME_REDIS_URL=redis://localhost:6380
# The Pub/Sub channel. Two deployments sharing one Redis need two of these, or
# each reads the other's events.
REALTIME_CHANNEL=realtime
# How often an idle stream is given something to carry, so a proxy between the
# browser and here does not decide the connection is dead.
REALTIME_HEARTBEAT_SECONDS=15

# --- The assistant ---
# Which provider answers. `none` ships as the default and is a real choice: a
# boilerplate that demanded an API key to boot would be one nobody can run. The
# routes then answer a problem document saying which variable turns it on.
AI_PROVIDER=none
# AI_API_KEY=sk-...
# An OpenAI-compatible endpoint, for a gateway or a model running locally.
# AI_BASE_URL=https://api.example.com/v1
# What the two policy aliases resolve to. Feature code names `fast` or `smart`
# and never a model, so changing these is a deployment decision.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_SMART=claude-sonnet-4-5
# Embeddings are a separate decision: Anthropic publishes no embedding model,
# so a deployment answering with Claude still embeds with something else.
# **The dimension is in the migration, not here.** `vector(1536)` is fixed in
# the column, so a model with a different one is a migration and a re-embed.
AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_KEY=sk-...
# AI_EMBEDDING_BASE_URL=https://api.example.com/v1
# The soft monthly ceiling per organization. Soft because a completion's cost
# is not knowable before it exists: work in flight can carry the total past it.
AI_MONTHLY_TOKEN_LIMIT=1000000
# How many passages a question retrieves before the model sees them.
AI_SEARCH_LIMIT=5

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Object storage (MinIO in dev, any S3-compatible service in production) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=app

# --- Observability (pnpm dev:obs starts a collector at 4318) ---
# The collector's base address, without the `/v1/traces` path the exporter
# appends. Unset means nothing is traced, and that is a supported state: every
# request still carries an id and that id is still in every log line. What is
# lost is the join across processes.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Apps ---
PORT=3000

# Interactive API docs at /docs. Unset = on outside production, off in it.
# DOCS_ENABLED=true

# --- Authentication ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=development-secret-at-least-32-characters-long
# The origin a browser reaches the API on: the edge in production.
BETTER_AUTH_URL=http://localhost:3000

# Hops allowed to set X-Forwarded-*. Anything else naming its own address is
# ignored, which is what makes request.ip worth guarding on.
TRUSTED_PROXIES=127.0.0.1,::1

# Which sites a browser may call this API from, with credentials. This single
# value decides that, and it is also better-auth's trusted-origin list. Copy
# the template to production unchanged and you inherit localhost, so every
# real browser request is refused.
CORS_ORIGINS=http://localhost:4200

# Requests per window, per client address. The default suits a person; a load
# test or an end-to-end suite raises it deliberately.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# The address the service binds to. Defaults to loopback outside production so
# a development machine is not exposed to its network.
HOST=127.0.0.1

# --- Web ---
# The origin the browser addresses API calls to. In production that is the
# edge, which serves the application and the API under one name; the API
# container's own address must never appear here, and neither must a different
# site: a session cookie set for one origin is not sent to another, so the
# application would redirect a signed-in person back to sign in forever.
#
# Next inlines a NEXT_PUBLIC_* variable at BUILD time, so it has to be present
# when the image is built, not when the container starts.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000

# Attempts on a credential route, per address, per minute. Ten is what a
# deployment wants. This rig signs up once per test from one address, so it
# raises the number deliberately rather than discovering the limit as a
# failure that looks like a broken form.
AUTH_CREDENTIAL_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_MAX=300

# How long a session lives, and how often using it extends the expiry. An
# operator's decision, not a contract: a bank wants an hour where an internal
# tool wants a fortnight.
SESSION_MAX_AGE_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# How long a browser may reuse one preflight answer. Longer costs a round trip
# less often; shorter makes a policy change take effect sooner.
CORS_MAX_AGE_SECONDS=600

# The language somebody sees before they choose one. Inlined into the browser
# bundle at build time, like every NEXT_PUBLIC_* value.
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# --- Worker ---
# How many jobs one replica runs at once. The ceiling is the connection pool,
# not the CPU: every job in flight holds a database connection. The audit
# consumer runs at this number; the retention sweep runs at one, whatever this
# says, because a schedule producing one job an hour has nothing for a second
# worker to do. So the worker refuses to boot unless
# 3 * WORKER_CONCURRENCY + 2 <= WORKER_DATABASE_POOL_MAX — three consumers at
# this number, one for the sweep, one for the relay.
WORKER_CONCURRENCY=5

# How often the retention sweep runs. It is part of the schedule's identity, so
# changing it replaces the schedule rather than leaving two behind.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# How long a finished idempotency record stays replayable. Keep it far above
# the claim lease: deleting a record resets the fence token that makes a zombie
# writer safe.
IDEMPOTENCY_RETENTION_HOURS=24

# Where the worker records that it is alive and its queue is answering. Unset
# means the platform's temporary directory, named after the process so two
# workers on one machine do not share a file; the container names a path it can
# also read from its health check.
# WORKER_HEARTBEAT_FILE=/tmp/core-worker-heartbeat

# How often it records that. The container's health check reads the same value
# to decide how stale is too stale, so the two cannot drift apart.
WORKER_HEARTBEAT_INTERVAL_MS=10000

# --- Erasure (GDPR) ---
# Where the erasure job connects. `erasure_role` is the only role that may
# delete a person or edit an audit record — no consumer of the outbox can, so
# the trail's immutability is a permission rather than a convention. A fourth
# variable for the same reason the worker's is not the API's.
#
# **This variable is the switch.** Unset it and the worker registers no erasure
# schedule at all: requests to be forgotten are still recorded, and nothing
# acts on them. That is the right default for a deployment that has not set the
# role up yet — the alternative is a job that fails every day forever.
ERASURE_DATABASE_URL=postgresql://erasure_role:erasure_role@localhost:5432/app

# One connection: the job runs daily and holds it for the minute it takes.
ERASURE_DATABASE_POOL_MAX=1

# How long a soft-deleted person stays before the erasure is made real. The
# window is the feature — an erasure cannot be undone, and a mistaken one with
# no window is a support ticket nobody can answer.
ERASURE_GRACE_DAYS=30

# How often the job looks. Daily, because the window is measured in weeks.
ERASURE_SWEEP_INTERVAL_HOURS=24

# --- Storage ---
# `s3` or `local`. Both are real drivers and the same test suite runs against
# each; `local` streams through the API and needs no object store at all.
STORAGE_DRIVER=s3

# How long a signed upload or download URL lives.
STORAGE_SIGNED_URL_TTL_SECONDS=900

# The largest upload a signed policy admits — 100 MiB. A presigned POST policy
# makes the store refuse an oversized upload at the edge; the scanner checks it
# again afterwards, because a presigned PUT cannot express a bound.
STORAGE_MAX_UPLOAD_BYTES=104857600

# How long a record with no completed upload survives before it is swept.
# Longer than the signed URL above, or the sweep removes uploads in flight.
STORAGE_ABANDONED_UPLOAD_MINUTES=60

# Where the `local` driver keeps objects, and where its signed URLs point.
STORAGE_LOCAL_ROOT=.storage
STORAGE_PUBLIC_ORIGIN=http://localhost:3000

# What signs a `local` driver's URLs. Required when STORAGE_DRIVER=local, and
# unused otherwise — the S3 driver signs with the store's own credentials.
# STORAGE_SIGNING_SECRET=change-me-to-32-characters-or-more

# How often the scanner looks for uploads to check, and how many failures
# quarantine a file rather than retrying it.
FILE_SCAN_INTERVAL_MINUTES=1
FILE_SCAN_MAX_ATTEMPTS=3

# --- Webhooks ---
# How long a receiver has to answer before the attempt is a timeout. Short
# enough that a dead endpoint does not hold a worker slot, long enough that a
# receiver doing real work inside the request survives.
WEBHOOK_TIMEOUT_MS=10000

# How long an attempt row is kept — thirty days. The question the log answers
# is "why did last week's delivery fail", so a shorter window makes it useless
# for the case people actually look at.
WEBHOOK_DELIVERY_RETENTION_HOURS=720

# --- Connection pools ---
# How many database connections each process may hold. Two variables, for the
# same reason the connection strings are two: the API and the worker have
# different concurrency and different replica counts, so one number chosen to
# clear a worker's backlog would arrive at the API multiplied by its replicas.
# The worker refuses to start if its consumers cannot fit inside its pool.
DATABASE_POOL_MAX=10
# Larger, because the worker runs three consumers at WORKER_CONCURRENCY — the
# audit trail, the webhook dispatcher and the webhook sender — plus the sweep
# and the relay. At the shipped concurrency of five that is 17 connections.
WORKER_DATABASE_POOL_MAX=20

# --- The outbox relay ---
# How long the relay waits when there was nothing to deliver: the latency floor
# for an event, and the rate an idle system asks a question with no answer.
OUTBOX_POLL_MS=1000

# How many events one pass delivers. With the poll interval this is the
# delivery rate the sweep below has to keep up with.
OUTBOX_BATCH=100

# How long a claim is trusted before another replica may take it back. Bounded
# at both ends: below the worst enqueue round trip two relays deliver the same
# event, and above the queue's deduplication window that second delivery stops
# being a silent no-op. The relay checks the upper bound at boot.
OUTBOX_LEASE_MS=60000

# How long the relay waits for the queue to accept one event. Not optional: the
# queue's connection cannot give up on a command, so without this an outage
# stops the relay at a line that looks like it is working.
OUTBOX_ENQUEUE_TIMEOUT_MS=10000

# How often it looks for claims whose relay died. A recovery path, not the
# retry mechanism, so far less often than the poll.
OUTBOX_RECLAIM_MS=30000

# How often delivered events are removed, and how many batches each time. The
# product has to exceed OUTBOX_BATCH / OUTBOX_POLL_MS, or the outbox grows
# without bound inside its own retention window — and replicas do not close
# that gap, because they raise both sides equally.
OUTBOX_SWEEP_EVERY_MS=60000
OUTBOX_SWEEP_BATCHES=10

# How many times an event is tried before somebody has to look at it.
OUTBOX_MAX_ATTEMPTS=10

# How long a delivered event stays replayable. The records that make a replay
# safe are kept twice as long, because one that expired first would let a
# replayed event be processed again.
OUTBOX_RETENTION_HOURS=168

# --- Errors ---
# Where the error types named in a problem document are published. It appears
# in every error response, so a deployment that publishes them elsewhere says
# so rather than shipping a link to somebody else's domain.
PROBLEM_TYPE_BASE_URL=https://errors.example.com

# The zone timestamps are rendered in. Stated rather than inherited: without
# it the server formats in the machine's zone and the browser in the reader's,
# and the same instant renders differently on either side of hydration.
APP_TIME_ZONE=Asia/Ho_Chi_Minh

