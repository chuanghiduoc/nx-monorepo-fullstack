# Copy to .env and adjust. Values below match docker-compose.yml defaults.

# --- Database (spec §3: PostgreSQL 18 + Prisma 7, UUIDv7 generated by the DB) ---
# The application connects as app_user, which is bound by row-level security.
# Connecting as the owner would make every RLS policy advisory: FORCE ROW LEVEL
# SECURITY binds table owners and never superusers (ADR-0003).
DATABASE_URL=postgresql://app_user:app_user@localhost:5432/app
# Migrations run as the owner — DDL is deliberately outside app_user's rights.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Throwaway database Prisma replays migrations into when checking for drift.
# Never point this at a database that holds anything: Prisma resets it.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_shadow

# --- Redis: two roles, never one instance (spec §3 Redis topology) ---
# Queue, quota, rate limit, locks — must never evict.
REDIS_CRITICAL_URL=redis://localhost:6379
# Disposable cache and transient realtime state.
REDIS_CACHE_URL=redis://localhost:6380

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Object storage (MinIO in dev, any S3-compatible service in production) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=app

# --- Observability (docker compose --profile observability up -d) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Apps ---
PORT=3000

# Interactive API docs at /docs. Unset = on outside production, off in it.
# DOCS_ENABLED=true
