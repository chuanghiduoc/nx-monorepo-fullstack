{
  "name": "core-api-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core/api-e2e/src",
  "projectType": "application",
  "tags": [
    "scope:core",
    "platform:node",
    "type:app"
  ],
  "// targets": "to see all targets run: nx show project core-api-e2e --web",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "core-api"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "apps/core/api-e2e",
        "command": "vitest run --config vitest.e2e.config.mts"
      }
    }
  },
  "implicitDependencies": [
    "core-api"
  ]
}
