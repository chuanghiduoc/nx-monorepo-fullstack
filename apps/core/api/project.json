{
  "name": "core-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core/api/src",
  "projectType": "application",
  "tags": [
    "scope:core",
    "platform:node",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/core/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/core/api/dist/package.json",
        "{workspaceRoot}/apps/core/api/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/core/api/dist/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "core-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "core-api:build:development"
        },
        "production": {
          "buildTarget": "core-api:build:production"
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "!{projectRoot}/openapi.json"
      ],
      "outputs": [
        "{projectRoot}/openapi.json"
      ],
      "options": {
        "cwd": "apps/core/api",
        "command": "tsx --tsconfig tsconfig.app.json src/openapi.ts",
        "env": {
          "DATABASE_URL": "postgresql://openapi:openapi@localhost:5432/openapi",
          "REDIS_CRITICAL_URL": "redis://localhost:6379",
          "REDIS_CACHE_URL": "redis://localhost:6380"
        }
      },
      "dependsOn": [
        "^build"
      ]
    }
  }
}
