{
  "name": "core-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core/api/src",
  "projectType": "application",
  "tags": [
    "scope:core",
    "platform:node",
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/core/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/apps/core/api/dist/package.json",
        "{workspaceRoot}/apps/core/api/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/apps/core/api/dist/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "core-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "core-api:build:development"
        },
        "production": {
          "buildTarget": "core-api:build:production"
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "!{projectRoot}/openapi.json"
      ],
      "outputs": [
        "{projectRoot}/openapi.json"
      ],
      "options": {
        "cwd": "apps/core/api",
        "command": "tsx --tsconfig tsconfig.app.json src/openapi.ts",
        "env": {
          "DATABASE_URL": "postgresql://openapi:openapi@localhost:5432/openapi",
          "REDIS_CRITICAL_URL": "redis://localhost:6379",
          "REDIS_CACHE_URL": "redis://localhost:6380",
          "BETTER_AUTH_SECRET": "openapi-emission-only-not-a-real-secret",
          "BETTER_AUTH_URL": "http://localhost:3000"
        }
      },
      "dependsOn": [
        "^build"
      ]
    },
    "docker:build": {
      "//": "Declared rather than inferred. `@nx/docker` infers `docker build .` with the project directory as the context, and these Dockerfiles need the workspace root: the lockfile, the catalog and every library they import live there. Measured \u2014 the inferred target was `{\"cwd\": \"apps/core/api\", \"command\": \"docker build .\"}`, which cannot see any of it. The tag matches the plugin's own naming so the inferred `docker:run` still finds the image this builds.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "docker build -f apps/core/api/Dockerfile -t apps-core-api ."
      }
    },
    "openapi-check": {
      "//": "Regenerates the OpenAPI document and the client, then fails if either moved. This existed only in CI, and the gap was not theoretical: the committed document sat at five paths while the API served sixteen \u2014 eleven routes from webhooks, erasure, files, realtime and the assistant were missing from the contract and from the generated client, and `pnpm verify` said nothing for two phases. A check that only runs on a push is a check that lets the thing it guards rot locally.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "nx run core-api:openapi",
          "nx run shared-api-client-core:generate",
          "git add --intent-to-add -- apps/core/api/openapi.json libs/shared/api-client-core/src/generated",
          "git diff --exit-code -- apps/core/api/openapi.json libs/shared/api-client-core/src/generated"
        ]
      }
    }
  }
}
