{
  "name": "@workspace/core-worker",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "core-worker",
    "// serve.port": "The inspector port. The API keeps the default 9229 and `pnpm dev` starts both, so without this the second process to boot prints \"address already in use\" and runs with no debugger \u2014 which a developer discovers only when they try to attach one.",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/core/worker"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/core/worker/dist/package.json",
          "{workspaceRoot}/apps/core/worker/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/core/worker/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "core-worker:build",
          "runBuildTargetDependencies": false,
          "port": 9230
        },
        "configurations": {
          "development": {
            "buildTarget": "core-worker:build:development"
          },
          "production": {
            "buildTarget": "core-worker:build:production"
          }
        }
      },
      "docker:build": {
        "//": "Declared rather than inferred, for the reason written out in core-api: the build context is the workspace root.",
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{workspaceRoot}",
          "command": "docker build -f apps/core/worker/Dockerfile -t apps-core-worker ."
        }
      }
    },
    "tags": [
      "scope:core",
      "platform:node",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@workspace/core-server-core": "workspace:*",
    "@workspace/core-server-data-access-db": "workspace:*",
    "@workspace/core-server-flags": "workspace:*",
    "@workspace/core-server-observability": "workspace:*",
    "@workspace/core-server-queue": "workspace:*",
    "@workspace/core-server-realtime": "workspace:*",
    "@workspace/core-server-storage": "workspace:*",
    "@workspace/core-server-webhooks": "workspace:*",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/pg": "catalog:",
    "@workspace/core-server-testing": "workspace:*",
    "pg": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:"
  }
}
