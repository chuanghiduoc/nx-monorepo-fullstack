// Data layer for the core service.
//
// Conventions every model must follow:
//   - primary key is a UUIDv7 generated by PostgreSQL, not by the ORM, so rows
//     written by SQL scripts or a future non-TypeScript service get the same
//     kind of id;
//   - timestamps are TIMESTAMPTZ(3): PostgreSQL stores microseconds, but
//     JavaScript Date only carries milliseconds, so a column with more
//     precision holds values the application cannot represent - and a keyset
//     cursor built from a truncated value never matches its own row again;
//   - column names are snake_case via @map. PostgreSQL folds unquoted
//     identifiers to lower case, so a camelCase column has to be quoted in
//     every hand-written query, migration and non-TypeScript service;
//   - the table name is explicit via @@map, so renaming a model never renames a
//     table by accident.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API is bundled by webpack for a Node runtime. The ESM client re-exports
  // in a way webpack cannot resolve ("Cannot get final name for export
  // '$Enums'"), so the client is generated as CommonJS instead.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// class: GLOBAL — shared reference data, no tenant policy.
///
/// It exists to prove the conventions above end to end, and it is what the
/// demo endpoint and the pagination tests work against. Deliberately global:
/// an unauthenticated page reads it, and giving it an organization would make
/// the reference for the global pattern require a tenant.
model DemoItem {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Keyset pagination reads (created_at, id) in this order.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("demo_items")
}

/// class: TENANT_OWNED — every row belongs to exactly one organization.
///
/// The reference for the owned pattern: `org_id` is NOT NULL, the policy is
/// the single-branch template, and every index leads with `org_id` because
/// row-level security adds that predicate to every plan.
model Note {
  id    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  title String @db.VarChar(200)
  body  String @db.Text

  /// Optimistic concurrency: an update carries the version it read, and a
  /// mismatch is a 409 rather than a lost write. Two concurrent edits that
  /// both read version 3 cannot both win.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// `@updatedAt` is a Prisma behaviour, not a constraint: it sets the value
  /// on update and leaves the column NOT NULL with no default, so any insert
  /// that does not go through Prisma fails. The default makes the column
  /// correct for a SQL fixture, a backfill, or a service in another language.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notes")
}

/// class: TENANT_OPTIONAL — an organization's row, or a person's own.
///
/// The reference for the optional pattern, and the trap it hides: a policy of
/// `org_id IS NULL OR org_id = current` would show every personal bookmark to
/// every organization. The second branch must name the owner as well, which
/// is why `user_id` is NOT NULL even when `org_id` is not.
model Bookmark {
  id     String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId  String? @map("org_id") @db.Uuid
  userId String  @map("user_id") @db.Uuid
  url    String  @db.VarChar(2048)
  label  String  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("bookmarks")
}

/// class: TENANT_OWNED — an organization's own configuration.
///
/// Key-value rather than a column per setting: a setting is added by
/// registering a schema for its key, not by migrating a table, and a product
/// built on this platform adds settings the platform never heard of. The
/// value is validated against that schema on the way in, so "key-value" does
/// not mean "anything goes".
model OrgSetting {
  id    String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  key   String @db.VarChar(100)
  value Json

  /// Optimistic concurrency: two administrators editing the same setting do
  /// not silently overwrite each other.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([orgId, key])
  @@map("org_settings")
}

/// class: SYSTEM — belongs to no tenant; reached through grants, not policies.
///
/// Durable idempotency.
///
/// Redis alone would lose these on a restart, and a retried payment would run
/// twice. The unique key is the source of truth; Redis is only ever cache.
///
/// Every column in the unique key is NOT NULL on purpose: PostgreSQL treats
/// NULLs as distinct, so a nullable tenant column would let duplicates through
/// for exactly the callers who are not in an organization.
model IdempotencyRecord {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Who the key belongs to: an organization, a user, an API key, or the system.
  scopeType      String @map("scope_type") @db.VarChar(16)
  scopeId        String @map("scope_id") @db.VarChar(64)
  /// Method and normalised path, so the same key on two routes cannot collide.
  route          String @db.VarChar(200)
  idempotencyKey String @map("idempotency_key") @db.VarChar(200)

  /// Fingerprint of the request. Same key, different request means the client
  /// made a mistake, and replaying the old response would hide it.
  requestHash String @map("request_hash") @db.VarChar(64)
  state       String @db.VarChar(16)

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  /// Lease, not a timeout: expiry allows a recovery attempt, it does not prove
  /// the first attempt died. The fence token is what makes a zombie writer safe.
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  leaseUntil  DateTime  @map("lease_until") @db.Timestamptz(3)
  fenceToken  Int       @default(1) @map("fence_token")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  @@unique([scopeType, scopeId, route, idempotencyKey])
  @@index([completedAt])
  @@map("idempotency_records")
}

/// ---------------------------------------------------------------------------
/// better-auth (generated by @better-auth/cli, then given the workspace
/// conventions: snake_case columns, database-generated uuidv7 ids,
/// TIMESTAMPTZ(3)).
///
/// A user must be able to list every organization they belong to *before* any
/// organization is active, and better-auth's adapter runs outside our
/// transactions, so it never sets the tenant GUCs. Isolation for
/// these tables is better-auth's own access control, recorded in
///
/// Regenerate after a plugin change:
///   pnpm dlx @better-auth/cli@latest generate \
///     --config apps/core/api/better-auth.schema.ts --output <file> --yes
/// then re-apply the conventions below.
/// ---------------------------------------------------------------------------

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model User {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  email            String
  emailVerified    Boolean      @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?      @map("ban_reason")
  banExpires       DateTime?    @map("ban_expires") @db.Timestamptz(3)
  twoFactorEnabled Boolean?     @default(false) @map("two_factor_enabled")
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Session {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  token                String
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  impersonatedBy       String?  @map("impersonated_by") @db.Uuid

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Account {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  /// Added by better-auth 1.7; the schema generator (CLI 1.4) does not know
  /// about it yet, and a sign-up fails without it. auth-schema.spec.ts compares
  /// this model against the installed core so the next such gap is a test
  /// failure rather than a 500.
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Organization {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  slug              String
  logo              String?
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  metadata          String?
  organizationroles OrganizationRole[]
  members           Member[]
  invitations       Invitation[]

  @@unique([slug])
  @@map("organization")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model OrganizationRole {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permission     String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([role])
  @@map("organizationRole")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Member {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Invitation {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  inviterId      String       @map("inviter_id") @db.Uuid
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model TwoFactor {
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// class: AUTH — no tenant policy; isolation is the auth library's own.
model Apikey {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  configId            String    @default("default") @map("config_id")
  name                String?
  start               String?
  referenceId         String    @map("reference_id") @db.Uuid
  prefix              String?
  key                 String
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at") @db.Timestamptz(3)
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @default(86400000) @map("rate_limit_time_window")
  rateLimitMax        Int?      @default(10) @map("rate_limit_max")
  requestCount        Int?      @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request") @db.Timestamptz(3)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}
