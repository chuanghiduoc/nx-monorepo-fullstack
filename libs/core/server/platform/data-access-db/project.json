{
  "name": "core-server-data-access-db",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/core/server/platform/data-access-db/src",
  "projectType": "library",
  "tags": [
    "scope:core",
    "platform:node",
    "type:data-access"
  ],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma7.config.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ],
      "options": {
        "cwd": "libs/core/server/platform/data-access-db",
        "command": "prisma generate"
      }
    },
    "prisma-migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core/server/platform/data-access-db",
        "command": "prisma migrate status"
      }
    },
    "typecheck": {
      "dependsOn": [
        "prisma-generate",
        "^build"
      ]
    },
    "build": {
      "dependsOn": [
        "prisma-generate",
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma7.config.ts"
      ]
    },
    "test": {
      "dependsOn": [
        "prisma-generate",
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "prisma-generate"
      ]
    },
    "prisma-migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core/server/platform/data-access-db",
        "command": "prisma migrate deploy"
      }
    },
    "prisma-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core/server/platform/data-access-db",
        "command": "tsx tools/prisma-down.ts",
        "forwardAllArgs": true
      }
    },
    "write-tenant-models": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/core/server/platform/data-access-db",
        "command": "tsx tools/write-tenant-models.ts"
      }
    }
  }
}
