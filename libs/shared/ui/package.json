{
  "name": "@workspace/shared-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@workspace/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "@workspace/source": "./src/lib/*.ts",
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "@workspace/source": "./src/components/*.tsx",
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    }
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "react": "catalog:"
  }
}
